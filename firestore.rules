rules_version = '2';

// =====================================================================
// STERAS Firestore Security Rules
// =====================================================================
// Roles:
//   - organizer:  self-signup; can edit own Draft applications only
//   - authority:  server-provisioned only; reviews applications assigned to their agency
//   - public:     self-signup; reads public_events (same as logged-out users)
//   - admin:      server-provisioned only; reads submitted events for ops, never organizer Drafts
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOrganizer() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer';
    }

    function isAuthority() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'authority';
    }

    function isPublic() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'public';
    }

    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(organizerId) {
      return isSignedIn() && request.auth.uid == organizerId;
    }

    function isAssignedAuthority(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return isAuthority()
             && (event.keys().hasAny(['assignedOfficerUids'])
                 ? event.assignedOfficerUids.hasAny([request.auth.uid])
                 : false);
    }

    function isAdminReviewableEvent(eventId) {
      return isAdmin()
             && get(/databases/$(database)/documents/events/$(eventId)).data.status != 'Draft';
    }

    function isEditable(status) {
      return status == 'Draft';
    }

    function validM1TemplateSelection(data) {
      return data.templateSelection is map
        && data.templateSelection.keys().hasOnly([
          'eventCategory', 'venueSetting', 'coreTemplateId',
          'scenarioTemplateId', 'templateRegistryVersion', 'selectedAt'
        ])
        && data.templateSelection.coreTemplateId == 'STERAS-CORE'
        && data.templateSelection.templateRegistryVersion == '2026-08-28-v1'
        && data.templateSelection.selectedAt is int
        && data.templateSelection.selectedAt > 0
        && (data.eventDetails.type + '|' + data.templateSelection.eventCategory) in [
          'concert|entertainment_performance',
          'festival|cultural_heritage_festival',
          'sports|sports_recreational',
          'cultural|cultural_heritage_festival',
          'religious|cultural_heritage_festival',
          'exhibition|exhibition_convention_promotional',
          'fair|carnival_public_celebration',
          'conference|exhibition_convention_promotional',
          'other|carnival_public_celebration'
        ]
        && ((data.templateSelection.venueSetting == 'indoor' && data.eventDetails.environment == 'indoor')
          || (data.templateSelection.venueSetting != 'indoor' && data.eventDetails.environment in ['outdoor', 'mixed']))
        && (data.templateSelection.eventCategory + '|' + data.templateSelection.venueSetting + '|' + data.templateSelection.scenarioTemplateId) in [
          'entertainment_performance|indoor|STERAS-T01-ENT-IN-v2.0',
          'entertainment_performance|outdoor_fixed_site|STERAS-T02-ENT-OF-v1.0',
          'entertainment_performance|outdoor_route_based|STERAS-T03-ENT-OR-v1.0',
          'sports_recreational|indoor|STERAS-T04-SPT-IN-v1.0',
          'sports_recreational|outdoor_fixed_site|STERAS-T05-SPT-OF-v1.0',
          'sports_recreational|outdoor_route_based|STERAS-T06-SPT-OR-v1.0',
          'cultural_heritage_festival|indoor|STERAS-T07-CUL-IN-v1.0',
          'cultural_heritage_festival|outdoor_fixed_site|STERAS-T08-CUL-OF-v1.0',
          'cultural_heritage_festival|outdoor_route_based|STERAS-T09-CUL-OR-v1.0',
          'exhibition_convention_promotional|indoor|STERAS-T10-EXP-IN-v1.0',
          'exhibition_convention_promotional|outdoor_fixed_site|STERAS-T11-EXP-OF-v1.0',
          'exhibition_convention_promotional|outdoor_route_based|STERAS-T12-EXP-OR-v1.0',
          'carnival_public_celebration|indoor|STERAS-T13-CAR-IN-v1.0',
          'carnival_public_celebration|outdoor_fixed_site|STERAS-T14-CAR-OF-v1.0',
          'carnival_public_celebration|outdoor_route_based|STERAS-T15-CAR-OR-v1.0'
        ];
    }

    // ---- users collection ----
    // Self can read own profile.
    // Authorities can read other authorities (for assignment/coordination).
    // Admins can read all profiles (for ops).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId
                    || (isAuthority() && resource.data.role == 'authority')
                    || isAdmin());
      // Users can create their own profile on signup.
      // Allowed roles: 'organizer' or 'public' (NOT 'admin' or 'authority' — those are server-only).
      allow create: if isSignedIn() && request.auth.uid == userId
                    && (request.resource.data.role == 'organizer' || request.resource.data.role == 'public')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'uid', 'name', 'email', 'role', 'phone',
                      'createdAt', 'updatedAt', '_serverCreatedAt'
                    ]);
      // Users can update their own non-role fields.
      // Role changes are server-only (set by Cloud Functions / admin SDK).
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'name', 'email', 'phone', 'updatedAt'
                    ]);
      allow delete: if false; // disable client-side deletion
    }

    // ---- events collection ----
    match /events/{eventId} {
      // Organizer can read their own event.
      // Only the named officer assigned to the active event version can read
      // an application. Authority membership alone is not sufficient.
      // Admin workflows start only after organizer submission. Drafts remain
      // private to their organizer until the server advances the status.
      // Public viewers should query `public_events` instead — not `events`.
      allow read: if (isAdmin() && resource.data.status != 'Draft')
                  || isAssignedAuthority(eventId)
                  || (isSignedIn() && isOwner(resource.data.organizerId));

      // Drafts are client-created. Submission and revision preparation are server-owned.
      allow create: if isOrganizer()
                    && request.resource.data.organizerId == request.auth.uid
                    && request.resource.data.status == 'Draft'
                    && request.resource.data.currentVersionNumber == 0
                    && request.resource.data.editableVersionId == 'v1'
                    && request.resource.data.documentSchemaVersion == '2026-08-28-document-v1'
                    && request.resource.data.evidenceManifestSchemaVersion == '2026-08-28-evidence-v1'
                    && request.resource.data.draftEvidenceManifest is list
                    && request.resource.data.draftEvidenceManifest.size() >= 13
                    && request.resource.data.draftEvidenceManifest.size() <= 19
                    && !request.resource.data.keys().hasAny([
                      'eventId', 'currentExtractionId', 'activeRevision',
                      'cancelledAt', 'cancelledFromVersionId',
                      'withdrawnAt', 'withdrawnFromStatus', 'withdrawalRationale'
                    ])
                    && validM1TemplateSelection(request.resource.data)
                    && request.resource.data.draftDocumentPaths.size() == 0
                    && (!request.resource.data.keys().hasAny(['draftDocuments'])
                        || request.resource.data.draftDocuments.size() == 0)
                    && request.resource.data.requiredAuthorities.size() == 0;

      // Submitted Pending versions are immutable. Generated pointers and status
      // transitions are server-owned.
      allow update: if isOwner(resource.data.organizerId)
                    && isEditable(resource.data.status)
                    && request.resource.data.organizerId == resource.data.organizerId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.status == resource.data.status
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'currentVersionId', 'currentAssessmentId', 'currentResourceId',
                      'currentExtractionId',
                      'documentSchemaVersion',
                      'evidenceManifestSchemaVersion',
                      'activeRevision',
                      'cancelledAt', 'cancelledFromVersionId',
                      'withdrawnAt', 'withdrawnFromStatus', 'withdrawalRationale',
                      'initialReview', 'secondReview',
                      'eventId',
                      'requiredAuthorities', 'currentVersionNumber', 'editableVersionId',
                      'submittedAt'
                    ])
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['templateSelection'])
                        ? (!resource.data.keys().hasAny(['templateSelection'])
                            || validM1TemplateSelection(request.resource.data))
                        : (resource.data.draftDocumentPaths.size() == 0
                            && request.resource.data.draftDocumentPaths.size() == 0
                            && validM1TemplateSelection(request.resource.data))
                    );

      // Status transitions to Approved/Rejected/UnderReview are server-only (Cloud Functions).
      allow delete: if false;

      match /versions/{versionId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId))
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId));
        allow write: if false;
      }

      match /document_extractions/{extractionId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId))
                    || (isSignedIn() && isAssignedAuthority(eventId));
        allow write: if false;
      }

      match /assessments/{assessmentId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId));
        allow write: if false;

        match /score_reviews/{reviewId} {
          allow read: if isAdminReviewableEvent(eventId)
                      || (isSignedIn() && isAssignedAuthority(eventId)
                          && resource.data.authorityType == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.authorityType);
          allow write: if false;
        }

        match /score_resolutions/{resolutionId} {
          allow read: if isAdminReviewableEvent(eventId)
                      || (isSignedIn() && isAssignedAuthority(eventId));
          allow write: if false;
        }

        match /manual_assessments/{manualAssessmentId} {
          allow read: if isAdminReviewableEvent(eventId)
                      || (isSignedIn() && isAssignedAuthority(eventId));
          allow write: if false;
        }
      }

      match /assessment_summaries/{assessmentId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId))
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId));
        allow write: if false;
      }

      // ---- Sub-collection: resources ----
      // Written by Cloud Functions only.
      match /resources/{resourceId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId));
        allow write: if false; // server-only
      }

      match /decisions/{decisionId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId));
        allow write: if false;
      }

      match /decision_history/{historyId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId));
        allow write: if false;
      }

      match /resource_overrides/{overrideId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId));
        allow write: if false;
      }

      // Authority score confirmations/overrides. Server-written and visible
      // only to admins, the named authority, or the event owner.
      match /assessment_reviews/{reviewId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId))
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId));
        allow write: if false;
      }

      // ---- Sub-collection: event_controls (Stage-1 controls, M3) ----
      // Private controls are visible only to the review participants and
      // organizer. Public viewers use the sanitised projection below.
      // Writes server-only (organisers populate via Cloud Function;
      // verifications via verifyStage1Doc).
      match /event_controls/{controlId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId))
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId));
        allow write: if false; // server-only
      }

      // ---- Sub-collection: control_verifications (M3 verified-control workflow) ----
      // Read by assigned authority + event owner + admin. Writes server-only
      // (verifyEventControl Cloud Function is the only writer).
      match /control_verifications/{verificationId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId))
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId));
        allow write: if false; // server-only
      }

      // ---- Sub-collection: assignments (M3 round N+1, Workstream 1) ----
      // One doc per required authorityType per version. Created by
      // `assignAuthorityOfficers`; read by the assigned officer, the
      // admin, and the event owner. Writes server-only.
      match /assignments/{assignmentId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId))
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId));
        allow write: if false; // server-only
      }

      // ---- Sub-collection: stage1_docs (M3 round N+1, Workstream 3) ----
      // Per-doc Stage 1 evidence (application, license, insurance, ...).
      // Read by assigned authority + event owner + admin. Writes server-only
      // (verifyStage1Doc + submitStage1Doc Cloud Functions).
      match /event_controls/{controlId}/stage1_docs/{docId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId))
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId));
        allow write: if false; // server-only
      }

      // ---- Sub-collection: stage2_docs (M3 round N+1, Workstream 5) ----
      // Private organizer uploads and review state. Public viewers use the
      // sanitised `public_event_controls/{eventId}/items` projection below.
      // Writes are server-only (submitStage2Doc / publishStage2Doc /
      // unpublishStage2Doc Cloud Functions).
      match /event_controls/{controlId}/stage2_docs/{docId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && isAssignedAuthority(eventId))
                    || (isSignedIn() && isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId));
        allow write: if false; // server-only
      }

      // ---- Per-control rate-limit counters (M3 round N+1, Workstream 4) ----
      // Server-only writes (confirmStage2Doc / reportStage2Doc). Client
      // reads for the UI to show "You confirmed" / "You reported" states.
      match /event_controls/{controlId}/stage2_confirms/{userId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && request.auth.uid == userId);
        allow write: if false; // server-only
      }
      match /event_controls/{controlId}/stage2_reports/{userId} {
        allow read: if isAdminReviewableEvent(eventId)
                    || (isSignedIn() && request.auth.uid == userId);
        allow write: if false; // server-only
      }

      // ---- Sub-collection: audit_logs ----
      // Append-only. Read by authorities + admins. Never client-writable.
      match /audit_logs/{logId} {
        allow read: if isAdminReviewableEvent(eventId) || (isSignedIn() && isAssignedAuthority(eventId));
        allow write: if false; // server-only
      }
    }

    // ---- officers (M3 round N+1, Workstream 1) ----
    // Top-level collection. Read by signed-in (the assignment checklist
    // needs everyone to see the officer list). Writes are admin-only on
    // the client; M3 server can write via Admin SDK.
    match /officers/{officerId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---- public_event_controls (M3 round N+1, Workstream 5) ----
    // Sanitised public view of published Stage 1/2 documents. Read by
    // anyone (public viewer). Writes server-only.
    match /public_event_controls/{eventId}/{controlId}/{stage}/{docId} {
      allow read: if true;
      allow write: if false; // server-only
    }

    // Canonical sanitised projection used by the public event page.
    // `items` is a sub-collection under the event document so a public
    // viewer can subscribe to one event without querying private controls.
    match /public_event_controls/{eventId}/items/{publicControlId} {
      allow read: if true;
      allow write: if false; // server-only
    }

    // ---- public_reports (M3 round N+1, Workstream 4 + 6) ----
    // Public Stage 2 inaccurate reports. M3 writes when a public user
    // reports; M4 updates `outcome` after investigation; M3 listens.
    // Read scoped to: reporter, admin, assigned authority, event owner.
    match /public_reports/{ticketId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.reporterUid == request.auth.uid)
                  || (isSignedIn() && resource.data.eventId != null
                      && isAssignedAuthority(resource.data.eventId))
                  || (isSignedIn() && resource.data.eventId != null
                      && isOwner(get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizerId));
      // Reports must go through reportStage2Doc so the published projection,
      // per-user rate limit, and M4 ticket are updated atomically. M4 writes
      // outcomes with the Admin SDK and therefore bypasses these client rules.
      allow create, update, delete: if false;
    }

    // ---- venues (read-only for all signed-in users, write = admin/seed) ----
    match /venues/{venueId} {
      allow read: if isSignedIn();
      allow write: if false; // seeded via admin SDK / Cloud Functions

      match /audit_logs/{auditId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /admin_operations/{operationId} {
      allow read, write: if false;
    }

    match /admin_audit_logs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- M4 incidents — privacy-safe access goes through role-aware callables ----
    match /incidents/{incidentId} {
      allow read, write: if false;
      match /history/{historyId} {
        allow read, write: if false;
      }
    }

    // Directory contacts are returned through a bounded authenticated callable.
    match /authority_directory/{authorityId} {
      allow read, write: if false;
    }

    // Historical outcomes are evidence for server-side M2 retrieval. Synthetic
    // records remain visible to authority reviewers for provenance inspection.
    match /historical_events/{historicalEventId} {
      allow read: if isAdmin() || (isSignedIn() && isAuthority());
      allow write: if false;
    }

    // Dataset manifests disclose origin, intended use, and synthetic status.
    match /dataset_manifests/{manifestId} {
      allow read: if isAdmin() || (isSignedIn() && isAuthority());
      allow write: if false;
    }

    // ---- public_events (read-only for everyone, written by Cloud Functions) ----
    match /public_events/{eventId} {
      allow read: if true;
      allow write: if false; // server-only
    }

    // ---- notifications (durable in-app notifications, FR-M3-08) ----
    // Users see only their own notifications. Admin can read all (for
    // ops + audit). Writes are server-only (the Cloud Functions
    // createNotification helper is the only writer).
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow write: if false; // server-only (Cloud Function)
    }
  }
}
