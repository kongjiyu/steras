# Explicit opt-in for the manifest-managed Module 3 dataset on linkos.
# Supply credentials through Application Default Credentials; never use a
# service-account key committed inside this repository.
STERAS_BASE_URL=https://linkos-496505.web.app
STERAS_E2E_PROJECT_ID=linkos-496505
STERAS_E2E_ALLOW_RESET=true
STERAS_E2E_ALLOW_SHARED_PROJECT=true
STERAS_E2E_DATASET_ID=m3-linkos-v1
STERAS_E2E_PASSWORD=<temporary-password-at-least-12-characters>
M3_UAT_STORAGE_BUCKET=linkos-496505.firebasestorage.app

