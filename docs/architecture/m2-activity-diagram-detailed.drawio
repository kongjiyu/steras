        <mxCell id="native-line-496" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=0;rounded=0;endArrow=none;startArrow=none;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="9112.5398" y="53.4106" as="sourcePoint"/><mxPoint x="9112.5398" y="7715.5229" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="native-rect-497" value="" style="rounded=0;arcSize=14;whiteSpace=wrap;html=0;fillColor=#EDE2F7;strokeColor=#EDE2F7;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="10118.5623" y="53.4106" width="1436.2988" height="7662.1123" as="geometry"/></mxCell>
        <mxCell id="native-note-498" value="" style="shape=note;size=10;html=0;whiteSpace=wrap;fillColor=#FFF8D9;strokeColor=#D8B84B;strokeWidth=0.5;" vertex="1" parent="1"><mxGeometry x="10595.0588" y="7294.658" width="954.8022999999994" height="111.1913999999997" as="geometry"/></mxCell>
        <mxCell id="native-text-499" value="View-use-case alternatives:" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="10601.0588" y="7298.3775" width="123.2471" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-500" value="Risk-assessment-view A1 unauthorised → message “You are not authorised to view this assessment”;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="10601.0588" y="7311.0264" width="451.0771" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-501" value="A2 processing/failed/absent → show safe state; A3 legacy/stale → label and do not show current;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="10601.0588" y="7323.6753" width="431.4941" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-502" value="A4 restricted evidence → deny request, keep summary; A5 leave page → no data change. Resource-view A1 unauthorised; A2 processing/absent/failed; A3 stale/legacy;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="10601.0588" y="7336.3243" width="746.9976" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-503" value="A4 item unavailable/review-required → show reason, no fabricated default; A5 leave page. AI-analysis-view A1 unauthorised; A2 unavailable/invalid/retryable → safe status, no rejected raw output;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="10601.0588" y="7348.973199999999" width="875.5869" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-504" value="A3 stale/other input → label legacy; A4 restricted evidence → indicator only; A5 leave page. Organiser-summary-view A1 unauthorised; A2 processing/unavailable/failed/absent → safe status, no invented result;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="10601.0588" y="7361.6221" width="935.8022" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-505" value="A3 stale input → label stale; A4 restricted field → safe fields only; A5 leave page. All viewing constraints: role-based least privilege; current/processing/failed/incomplete/" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="10601.0588" y="7374.271" width="757.4067" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-506" value="stale states are distinct; viewing never changes assessment, resources, or authority decisions." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="10601.0588" y="7386.92" width="409.4941" height="15.95" as="geometry"/></mxCell>
