        <mxCell id="native-text-215" value="MiniMax unavailable, timeout, empty," style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=13;fontStyle=0;fontColor=#20242A;" vertex="1" parent="1"><mxGeometry x="2369.9117" y="4226.346100000001" width="202.7383" height="18.849999999999998" as="geometry"/></mxCell>
