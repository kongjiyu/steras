        <mxCell id="native-text-112" value="A1 reusable snapshot exists?" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=13;fontStyle=0;fontColor=#20242A;" vertex="1" parent="1"><mxGeometry x="2395.3658" y="2101.9718" width="151.8301" height="18.849999999999998" as="geometry"/></mxCell>
        <mxCell id="native-text-113" value="Yes" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=13;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="2363.1486" y="2094.4975" width="22.2173" height="18.849999999999998" as="geometry"/></mxCell>
