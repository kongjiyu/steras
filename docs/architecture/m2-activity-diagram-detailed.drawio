        <mxCell id="native-text-425" value="A2 retrieval failure → failed/insufficient-data, store safe audit, end;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4633.9536" y="6397.9758999999995" width="299.4888" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-426" value="A3 gate not ready → provisional path or skip AI/risk/resources and require review;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4633.9536" y="6410.6248" width="367.9487" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-427" value="A4 AI failure → , no fabricated scores, consolidate review-required;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4633.9536" y="6423.2737" width="302.8511" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-428" value="A5 calculation failure → preserve warnings, risk unavailable;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4633.9536" y="6435.9227" width="273.2349" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-429" value="A6 resource failure → store unavailable item/status;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4633.9536" y="6448.5716" width="231.7002" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-430" value="A7 final storage conflict → cancel stale publication, bounded idempotent retry. Storage alternatives:" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4633.9536" y="6461.220499999999" width="443.6865" height="15.95" as="geometry"/></mxCell>
