        <mxCell id="native-text-100" value="Contextual-evidence alternative flow details:" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="1953.5408" width="199.6187" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-101" value="A2 Weather unavailable/stale/outside horizon → store explicit status;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="1966.1897000000001" width="307.771" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-102" value="A3 Holiday dataset unavailable → calendar evidence unavailable;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="1978.8387" width="292.458" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-103" value="A4 Venue unmatched/no eligible history → empty eligible-history result;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="1991.4876000000002" width="325.2109" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-104" value="A5 Conflict/missing provenance/ineligible item → exclude or flag and reduce confidence;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="2004.1365" width="399.0903" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-105" value="A6 No eligible incident information → exclude it; absence is not proof of no risk. Weather-data alternatives: invalid location/date; provider error/rate-limit/timeout;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="2016.7854" width="723.7998" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-106" value="outside forecast horizon; malformed or irrelevant response." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="2029.4344" width="262.5464" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-107" value="Public-holiday alternatives: invalid local date; dataset read failure;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="2042.0833" width="294.3057" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-108" value="conflicting jurisdiction/date entries." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="2054.7322" width="158.707" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-109" value="Venue-history alternatives: ambiguous venue; no eligible history; unnormalisable outcome;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="2067.3812" width="404.6279" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-110" value="database query failure." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2563.1959" y="2080.0301" width="101.8647" height="15.95" as="geometry"/></mxCell>
