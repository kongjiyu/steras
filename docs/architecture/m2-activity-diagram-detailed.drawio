        <mxCell id="native-text-202" value="Record accepted proposals, rejected items, warnings, review indicators, model/prompt/ rubric/schema versions, timing, and provenance [FR-M2-08] [FR-M2-09]" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=13;fontStyle=0;fontColor=#20242A;" vertex="1" parent="1"><mxGeometry x="2050.2406" y="4054.9081" width="842.0806" height="18.849999999999998" as="geometry"/></mxCell>
        <mxCell id="native-note-203" value="" style="shape=note;size=10;html=0;whiteSpace=wrap;fillColor=#FFF8D9;strokeColor=#D8B84B;strokeWidth=0.5;" vertex="1" parent="1"><mxGeometry x="2582.65" y="4091.3701" width="707.9413999999997" height="136.48930000000018" as="geometry"/></mxCell>
        <mxCell id="native-text-204" value="AI-response-validation alternative flow details:" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4095.0896000000002" width="210.0117" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-205" value="A1 schema failure → reject response, record schema errors, trigger AI-failure handling;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4107.7386" width="388.3643" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-206" value="A2 unsupported category → reject/flag category; return invalid if required categories remain incomplete;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4120.3875" width="464.4297" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-207" value="A3 out-of-range/missing score → reject without inventing, clamping, or silent correction;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4133.0364" width="396.0664" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-208" value="A4 unsupported evidence ref → warn and reject/flag affected proposal;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4145.685399999999" width="315.6719" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-209" value="A5 hard-rule/rubric conflict → retain proposed value, record adjustment, mark review;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4158.3342999999995" width="383.8042" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-210" value="A6 low confidence/incomplete rationale → warn and mark review. AI-assisted-analysis alternatives:" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4170.9832" width="444.5942" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-211" value="A1 missing model/prompt/schema/credential; A2 API error/rate-limit/timeout;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4183.6321" width="347.5063" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-212" value="A3 empty/provider error response; A4 validation rejects complete response. AI-failure A3 storage failure: preserve safe failure in parent transaction/logging" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4196.2811" width="688.9414" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-213" value="path for later idempotent persistence. No raw secrets are exposed." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="2588.65" y="4208.929999999999" width="291.2441" height="15.95" as="geometry"/></mxCell>
