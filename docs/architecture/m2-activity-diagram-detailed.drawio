        <mxCell id="native-text-98" value="Check whether a current snapshot satisfies freshness rules [FR-M2-02]" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=13;fontStyle=0;fontColor=#20242A;" vertex="1" parent="1"><mxGeometry x="2285.799" y="1913.3592999999998" width="370.9639" height="18.849999999999998" as="geometry"/></mxCell>
