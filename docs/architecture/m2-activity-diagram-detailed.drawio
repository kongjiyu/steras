        <mxCell id="native-text-404" value="Contextual-evidence alternative flow details:" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4635.3977" y="1953.5408" width="199.6187" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-405" value="A2 Weather unavailable/stale/outside horizon → store explicit status;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4635.3977" y="1966.1897000000001" width="307.771" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-406" value="A3 Holiday dataset unavailable → calendar evidence unavailable;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4635.3977" y="1978.8387" width="292.458" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-407" value="A4 Venue unmatched/no eligible history → empty eligible-history result;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4635.3977" y="1991.4876000000002" width="325.2109" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-408" value="A5 Conflict/missing provenance/ineligible item → exclude or flag and reduce confidence;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4635.3977" y="2004.1365" width="399.0903" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-409" value="A6 No eligible incident information → exclude it; absence is not proof of no risk. Weather-data alternatives: invalid location/date; provider error/rate-limit/timeout;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4635.3977" y="2016.7854" width="723.7998" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-410" value="outside forecast horizon; malformed or irrelevant response." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4635.3977" y="2029.4344" width="262.5464" height="15.95" as="geometry"/></mxCell>
        <mxCell id="native-text-411" value="Public-holiday alternatives: invalid local date; dataset read failure;" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=11;fontStyle=0;fontColor=#40351A;" vertex="1" parent="1"><mxGeometry x="4635.3977" y="2042.0833" width="294.3057" height="15.95" as="geometry"/></mxCell>
