        <mxCell id="native-text-96" value="Receive normalised event date, venue/location, characteristics, and evidence request [FR-M2-01]" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=13;fontStyle=0;fontColor=#20242A;" vertex="1" parent="1"><mxGeometry x="2217.2411" y="1858.4105" width="508.0796" height="18.849999999999998" as="geometry"/></mxCell>
