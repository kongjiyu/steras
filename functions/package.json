{
  "name": "@steras/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:authority": "npm run build && node lib/functions/src/seed/seedAuthority.js",
    "seed:admin": "npm run build && node lib/functions/src/seed/seedAdmin.js",
    "seed:demo": "npm run build && node lib/functions/src/seed/seedDemo.js",
    "seed:steras:test": "npm run build && node lib/functions/src/seed/seedSterasTest.js",
    "seed:venues:staging": "npm run build && node lib/functions/src/seed/seedVenues.js",
    "migrate:m3": "npm run build && node lib/functions/src/scripts/migrateM3Deployment.js",
    "migrate:m3:decision-contract": "npm run build && node lib/functions/src/scripts/migrateM3DecisionContract.js",
    "migrate:m3:decision-contract:snapshot": "npm run build && node lib/functions/src/scripts/migrateM3DecisionContract.js --snapshot",
    "verify:minimax": "npm run build && node --env-file=.env --env-file=.secret.local lib/functions/src/scripts/verifyMiniMaxModel.js",
    "verify:external": "npm run build && node --env-file=.env --env-file=.secret.local lib/functions/src/scripts/verifyExternalServices.js",
    "uat:staging": "npm run build && node --env-file=../frontend/.env lib/functions/src/scripts/runStagingUat.js",
    "uat:fallback": "npm run build && node --env-file=../frontend/.env lib/functions/src/scripts/verifyStagingFallback.js",
    "uat:m1-admin-venues": "npm run build && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 GCLOUD_PROJECT=steras-test node lib/functions/src/scripts/runM1AdminVenueUat.js",
    "cutover:m2-v3": "npm run build && node --env-file=.env --env-file=.secret.local lib/functions/src/scripts/cutoverAssessmentV3.js",
    "cutover:resource-v3": "npm run build && node --env-file=.env lib/functions/src/scripts/cutoverResourceV3.js",
    "cutover:m2-hardening": "npm run build && node --env-file=.env --env-file=.secret.local lib/functions/src/scripts/cutoverM2Hardening.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run --config vitest.config.mts",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "axios": "^1.7.9",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "jszip": "^3.10.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.6.3"
  }
}

